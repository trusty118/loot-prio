    ">>": { "advances": true,  "label": "much higher than" },
    "~>": { "advances": true,  "label": "roughly higher than" },
    "=":  { "advances": false, "label": "equal to" },
    "~=": { "advances": false, "label": "roughly equal to" },
    "?":  { "advances": false, "label": "not ranked against" }
